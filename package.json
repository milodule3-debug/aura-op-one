{
  "name": "aura-op-one",
  "version": "0.1.0",
  "description": "Aura OP One — the minimal personal and agentic client for the Aura ecosystem. A quiet conversation with memory, a chosen agent, and a verification state you can trust.",
  "bin": {
    "opone": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "AURA_OP_ONE_ARCHITECTURE.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "aura",
    "aura-code",
    "agent",
    "ai",
    "cli",
    "coding-agent",
    "verification",
    "memory",
    "llm",
    "tui"
  ],
  "author": "Dusan Milosavljevic",
  "license": "MIT",
  "homepage": "https://github.com/milodule3-debug/aura-op-one#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milodule3-debug/aura-op-one.git"
  },
  "bugs": {
    "url": "https://github.com/milodule3-debug/aura-op-one/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "aura-code": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
